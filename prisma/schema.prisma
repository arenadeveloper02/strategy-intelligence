generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StrategyBrief {
  id                   String    @id @default(cuid())
  companyName          String
  industry             String
  objective            String
  marketFocus          String
  priorityServiceLines String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt @default(now())
  insights             Insight[]
}

model Insight {
  id        String        @id @default(cuid())
  title     String
  content   String
  category  String
  briefId   String
  brief     StrategyBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt @default(now())
}

model ReportRun {
  id          String   @id @default(cuid())
  companyName String
  status      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())
}
